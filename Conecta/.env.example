# ==============================================================================
# Variáveis de Ambiente - Conecta (Infraestrutura Monorepo)
# ==============================================================================

# PostgreSQL (Credenciais do ambiente existente)
POSTGRES_USER=admin
POSTGRES_PASSWORD=<defina-uma-senha-local>
POSTGRES_DB=monorepo_db
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379

# Backend (.NET API)
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Frontend (React Web)
FRONTEND_PORT=3000

# JWT: configurar valores acordados com o emissor, sem versionar a chave.
JWT_ISSUER=<emissor>
JWT_AUDIENCE=<audiencia>
JWT_SIGNING_KEY=<chave-HS256-de-pelo-menos-32-bytes>
